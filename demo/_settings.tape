# 公共设置，被其他 tape 用 Source 引入。
# 尺寸：1200x720 像素、字号 16 时约 120 列，足够让 /gal 面板出现在对话右侧（需约 110 列以上）。
Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set FontSize 16
Set Width 1200
Set Height 720
Set Padding 16
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful
Set TypingSpeed 60ms
Set Framerate 30
Set CursorBlink false
